# FLYPY MONSTER - MANUAL CONFIGURATION
# Keep this file named exactly .env

PORT=3000
HOST=0.0.0.0

# LIVE market candle endpoint.
# It must return JSON containing candles/data/results/values
# with OHLC fields: time, open, high, low, close.
LIVE_FEED_URL=

# OTC market candle endpoint.
# Use a genuine OTC data source. Do not use random/synthetic candles.
OTC_FEED_URL=

# Optional custom endpoint for providers that handle sub-minute candles.
# 15s/30s require genuine sub-minute candles or valid tick-resampled candles.
CUSTOM_CANDLE_API_URL=

CORS_ORIGIN=*

# Minimum valid candles required before a signal can be considered.
MIN_CANDLES=120

# Cache duration for your frontend/backend integration, in milliseconds.
CACHE_MS=2500
